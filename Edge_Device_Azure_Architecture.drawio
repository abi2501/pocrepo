<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-09-24T00:00:00.000Z" agent="OpenAI" version="24.7.17"><diagram id="edge-azure-arch" name="Architecture"><mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5600" pageHeight="3300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="azureRegion" value="&lt;b&gt;MICROSOFT AZURE CLOUD&lt;/b&gt;&lt;br&gt;Identity, RBAC Sync API, IoT Hub, ADX, monitoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ff;strokeColor=#77baf5;strokeWidth=3;fontSize=32;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=14;spacingLeft=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="220" width="5490" height="1390" as="geometry" /></mxCell><mxCell id="edgeRegion" value="&lt;b&gt;RASPBERRY PI / LINUX EDGE DEVICE&lt;/b&gt;&lt;br&gt;Python + PyQt + systemd + SQLite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#effced;strokeColor=#63b85b;strokeWidth=3;fontSize=32;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=14;spacingLeft=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="1770" width="5490" height="1290" as="geometry" /></mxCell><mxCell id="entra" value="&lt;b&gt;1. Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;alice@company.com&lt;br&gt;bob@company.com&lt;br&gt;&lt;br&gt;&lt;b&gt;Application Roles&lt;/b&gt;&lt;br&gt;Operator&lt;br&gt;Supervisor&lt;br&gt;ServiceEngineer&lt;br&gt;DeviceAdmin&lt;br&gt;&lt;br&gt;Online authentication via MSAL / OAuth 2.0 / OIDC.&lt;br&gt;&lt;br&gt;&lt;b&gt;Never synchronize Entra passwords to the device.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f7dcc;strokeWidth=3;fontSize=26;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=14;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="110" y="355" width="990" height="1090" as="geometry" /></mxCell><mxCell id="api" value="&lt;b&gt;2. RBAC Sync API&lt;/b&gt;&lt;br&gt;Azure Function / App Service&lt;br&gt;&lt;br&gt;- Authenticates to Microsoft Graph&lt;br&gt;- Reads app-role assignments&lt;br&gt;- Filters device/site users&lt;br&gt;- Returns HTTPS JSON snapshot&lt;br&gt;- version + generatedUtc + validUntilUtc + users[]&lt;br&gt;- Graph credentials remain only in Azure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=3;fontSize=25;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=14;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1155" y="355" width="990" height="1090" as="geometry" /></mxCell><mxCell id="iothub" value="&lt;b&gt;3. Azure IoT Hub&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Per-device identity&lt;br&gt;- POC symmetric key; production X.509&lt;br&gt;- azure-iot-device SDK&lt;br&gt;- MQTT over WebSockets / TLS 443&lt;br&gt;- Device-to-cloud telemetry&lt;br&gt;- Built-in events endpoint&lt;br&gt;&lt;br&gt;Message: eventId, deviceId, sourceRecordId, eventTimeUtc, eventType, severity, payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d88e5;strokeWidth=3;fontSize=25;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=14;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="2200" y="355" width="990" height="1090" as="geometry" /></mxCell><mxCell id="adx" value="&lt;b&gt;4. Azure Data Explorer (ADX)&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Database: EdgeTelemetry&lt;br&gt;- Table: EdgeLogs&lt;br&gt;- Time-series/log analytics&lt;br&gt;- IoT Hub ingestion mapping&lt;br&gt;- EventTimeUtc + IoTHubEnqueuedTime&lt;br&gt;- KQL queries&lt;br&gt;- Deduplicate by EventId&lt;br&gt;- ADX Dashboard / later Grafana or Power BI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0ea5a5;strokeWidth=3;fontSize=25;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=14;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="3245" y="355" width="990" height="1090" as="geometry" /></mxCell><mxCell id="ops" value="&lt;b&gt;5. Security &amp; Monitoring&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Key Vault for cloud secrets/certs&lt;br&gt;- Azure Monitor / Application Insights&lt;br&gt;- Last-seen / sync backlog / failures&lt;br&gt;- Least privilege&lt;br&gt;- RBAC snapshot expiry policy&lt;br&gt;- Login and sync audit&lt;br&gt;&lt;br&gt;&lt;b&gt;Production&lt;/b&gt;&lt;br&gt;X.509, protected private keys, signed snapshots, lockout, controlled updates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=3;fontSize=25;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=14;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="4290" y="355" width="990" height="1090" as="geometry" /></mxCell><mxCell id="pyqt" value="&lt;b&gt;A. Existing PyQt Application&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Device UI / controls&lt;br&gt;- Writes telemetry SQLite&lt;br&gt;- Login UI&lt;br&gt;- Online: Entra/MSAL authentication&lt;br&gt;- Offline: local PIN verifier&lt;br&gt;- Reads cached app roles / permissions&lt;br&gt;- Enforces UI/API permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#45a049;strokeWidth=3;fontSize=25;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=14;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="110" y="1900" width="1180" height="980" as="geometry" /></mxCell><mxCell id="sync" value="&lt;b&gt;B. edge-sync.service&lt;/b&gt;&lt;br&gt;Always-running Python systemd service&lt;br&gt;&lt;br&gt;&lt;b&gt;Authorization Sync&lt;/b&gt;&lt;br&gt;- HTTPS RBAC API&lt;br&gt;- versioned snapshot&lt;br&gt;- atomic auth_cache.db update&lt;br&gt;- retain last valid cache on failure&lt;br&gt;&lt;br&gt;&lt;b&gt;Telemetry Sync&lt;/b&gt;&lt;br&gt;- read telemetry DB read-only&lt;br&gt;- durable checkpoint&lt;br&gt;- deterministic EventId&lt;br&gt;- IoT Hub send + retry/backoff&lt;br&gt;- checkpoint only after success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6d28d9;strokeWidth=3;fontSize=24;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=14;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1355" y="1900" width="1760" height="980" as="geometry" /></mxCell><mxCell id="authdb" value="&lt;b&gt;C1. auth_cache.db&lt;/b&gt;&lt;br&gt;&lt;br&gt;users&lt;br&gt;roles&lt;br&gt;user_roles&lt;br&gt;offline_credentials&lt;br&gt;auth_sync_state&lt;br&gt;login_audit&lt;br&gt;validUntilUtc&lt;br&gt;&lt;br&gt;Offline credential = salted slow hash, never plaintext." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d97706;strokeWidth=3;fontSize=24;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=14;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="3190" y="1900" width="690" height="980" as="geometry" /></mxCell><mxCell id="telemetrydb" value="&lt;b&gt;C2. telemetry.db&lt;/b&gt;&lt;br&gt;&lt;br&gt;device_logs / measurements&lt;br&gt;stable numeric ID&lt;br&gt;event timestamp&lt;br&gt;payload/status/severity&lt;br&gt;&lt;br&gt;PyQt writes while offline.&lt;br&gt;Sync agent reads read-only.&lt;br&gt;Checkpoint stored separately." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f8ff;strokeColor=#0284c7;strokeWidth=3;fontSize=24;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=14;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="3915" y="1900" width="690" height="980" as="geometry" /></mxCell><mxCell id="security" value="&lt;b&gt;D. Offline Login &amp; Security&lt;/b&gt;&lt;br&gt;&lt;br&gt;ONLINE -&gt; Entra via MSAL&lt;br&gt;OFFLINE -&gt; username + local PIN/passphrase&lt;br&gt;&lt;br&gt;- enabled user?&lt;br&gt;- RBAC snapshot still valid?&lt;br&gt;- verify Argon2id-style hash&lt;br&gt;- failed-attempt lockout&lt;br&gt;- audit login mode&lt;br&gt;- deny/restrict after cache expiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=3;fontSize=23;fontFamily=Helvetica;verticalAlign=top;align=left;spacingTop=14;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="4685" y="1900" width="805" height="980" as="geometry" /></mxCell><mxCell id="e1" value="1  App roles / Graph data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#7c3aed;endArrow=block;endFill=1;" edge="1" parent="1" source="entra" target="api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="2  HTTPS JSON snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#7c3aed;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="sync"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="3  Atomic update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#7c3aed;endArrow=block;endFill=1;" edge="1" parent="1" source="sync" target="authdb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="4  Offline users/roles" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#a16207;endArrow=block;endFill=1;" edge="1" parent="1" source="authdb" target="pyqt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="5  Write logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#2f7d32;endArrow=block;endFill=1;" edge="1" parent="1" source="pyqt" target="telemetrydb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="6  Read pending rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#0284c7;endArrow=block;endFill=1;" edge="1" parent="1" source="telemetrydb" target="sync"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="7  MQTT/TLS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#0284c7;endArrow=block;endFill=1;" edge="1" parent="1" source="sync" target="iothub"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="8  Stream ingestion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#0284c7;endArrow=block;endFill=1;" edge="1" parent="1" source="iothub" target="adx"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="9  Online login: MSAL/OIDC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#4f46e5;endArrow=block;endFill=1;dashed=1;dashPattern=8 8;" edge="1" parent="1" source="pyqt" target="entra"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="Monitoring" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#64748b;endArrow=block;endFill=1;dashed=1;dashPattern=8 8;" edge="1" parent="1" source="adx" target="ops"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>