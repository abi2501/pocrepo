# FastAPI v5 bulk snapshot. Base URL includes /api, but NOT /rbac/snapshot.
RBAC_API_BASE_URL=https://YOUR-APP.azurewebsites.net/api
# Same secret as Azure App Service RBAC_API_KEY. Keep private; do not commit .env.
RBAC_API_KEY=REPLACE_WITH_YOUR_EXISTING_RANDOM_32_PLUS_CHARACTER_SHARED_API_KEY
RBAC_HTTP_TIMEOUT_SECONDS=25

# Used ONLY if somebody enrolls their PIN for the first time.
ENTRA_TENANT_ID=YOUR-TENANT-GUID
EDGE_PUBLIC_CLIENT_ID=345e4a42-6fba-4c4f-b458-9e25d104aee7
PIN_API_CLIENT_ID=6fcce3c0-2437-4f54-ad20-5010055defc8

# Per-installation offline cache; keep folder protected by OS permissions.
AUTH_DB_PATH=./data/auth_cache.db
TELEMETRY_DB_PATH=./data/telemetry.db
SYNC_STATE_DB_PATH=./data/sync_state.db
OFFLINE_AUTH_MAX_FAILED=5
OFFLINE_AUTH_LOCK_SECONDS=300

# Optional separate IoT Hub telemetry component (not part of RBAC authentication).
IOTHUB_TELEMETRY_DEVICE_ID=EDGE-TELEMETRY-001
IOTHUB_DEVICE_CONNECTION_STRING=
TELEMETRY_POLL_SECONDS=5
TELEMETRY_BATCH_SIZE=100
TELEMETRY_RETRY_MAX_SECONDS=300
LOG_LEVEL=INFO
